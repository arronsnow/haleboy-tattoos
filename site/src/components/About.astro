---
import { Picture } from 'astro:assets';
import type { Content } from '../lib/content';
import type { ResponsiveImage } from '../lib/images';
import eathan from '../assets/eathan.jpg';
import Img from './Img.astro';

interface Props {
  portrait: ResponsiveImage | null;
  content: Content;
}

const { portrait, content } = Astro.props;
const paragraphs = [content.about_1, content.about_2, content.about_3].filter((p) => p.trim());
const alt = 'Haleboy at his station at I Love You Tattoo';
const sizes = '(max-width: 519.98px) 77vw, 400px';
---

<section class="about" id="about" aria-labelledby="about-title">
  <span class="jp" aria-hidden="true">彫師</span>
  <div class="art">
    <div class="rays" aria-hidden="true"></div>
    <div class="disc" aria-hidden="true"></div>
    <div class="panel frame">
      {portrait ? (
        <Img class="portrait" image={portrait} alt={alt} sizes={sizes} />
      ) : (
        <Picture class="portrait" src={eathan} alt={alt} formats={['avif', 'webp']} widths={[400, 600, 800]} sizes={sizes} loading="lazy" decoding="async" />
      )}
    </div>
  </div>
  <div class="copy">
    <h2 class="title" id="about-title">The Haleboy</h2>
    {paragraphs.map((p) => <p>{p}</p>)}
    <dl class="facts">
      <div>
        <dt>Styles</dt>
        <dd>{content.styles}</dd>
      </div>
      <div>
        <dt>Shop</dt>
        <dd><a href="https://iloveyou.tattoo/" target="_blank" rel="noopener">I Love You Tattoo<span class="visually-hidden"> (opens in a new tab)</span></a>, Maryville, TN</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    /* Clip top/bottom only: the backdrop bleeds sideways, the rays mustn't spill into Designs or Booking. */
    clip-path: inset(0 -100vmax);
    padding: 128px var(--gutter);
    display: grid;
    grid-template-columns: 520px minmax(0, 1fr);
    gap: 96px;
    align-items: center;
  }

  /* Full-bleed backdrop: a soft grey glow behind the portrait that fades to black at the edges,
     with a faint halftone dot screen that fades out the same way. */
  .about::before, .about::after {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
  }
  .about::before {
    background: radial-gradient(ellipse 60% 75% at 30% 50%, #2a2a2a 0%, var(--grey) 45%, var(--black) 100%);
  }
  .about::after {
    background-image: radial-gradient(rgb(244 242 238 / 0.07) 1.2px, transparent 1.6px);
    background-size: 12px 12px;
    mask-image: radial-gradient(ellipse 55% 70% at 30% 50%, #000 0%, transparent 80%);
  }

  /* 520×600 box from the design, kept in percentages so it scales down. */
  .art {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 520 / 600;
  }
  /* Light rays fanning out from behind the sun; centre = the disc's centre (50%, 36.67% of the 520×600 box). */
  .rays {
    position: absolute;
    left: 50%;
    top: 36.667%;
    /* The hero's rays at twice the angle, so they read as bold this close to the sun; faded out about one portrait-width beyond it. */
    width: 300%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: repeating-conic-gradient(from 0deg, rgb(244 242 238 / 0.08) 0deg 2.4deg, transparent 2.4deg 12deg);
    mask-image: radial-gradient(circle closest-side, #000 45%, transparent 100%);
    pointer-events: none;
  }

  .disc {
    position: absolute;
    left: 7.692%;
    top: 0;
    width: 84.615%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--red);
  }
  .frame {
    position: absolute;
    left: 0;
    top: 13.333%;
    width: 76.923%;
    height: 83.333%;
    overflow: hidden;
  }
  .frame :global(.portrait) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Above the rays, which are positioned and would otherwise paint over the text. */
  .copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 32px; max-width: 620px; }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 72px;
    line-height: 1.05;
    font-weight: 400;
  }
  /* A faded watermark down the section's right edge, out in the gutter, behind the text. */
  .jp {
    position: absolute;
    z-index: -1;
    top: 104px;
    right: 24px;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 245px;
    line-height: 1;
    color: var(--red);
    opacity: 0.16;
    pointer-events: none;
  }
  .copy p { margin: 0; font-size: 20px; line-height: 1.7; color: var(--ash); }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--ink);
  }
  .facts div { display: flex; flex-direction: column; gap: 6px; }
  .facts dt { font-size: 15px; color: var(--ash-dim); }
  .facts dd { margin: 0; font-size: 18px; font-weight: 500; }

  @media (max-width: 1180px) {
    .about { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 56px; }
    .title { font-size: 56px; }
    .jp { font-size: 190px; }
  }

  @media (max-width: 899.98px) {
    .jp { top: auto; bottom: 72px; right: 8px; font-size: 136px; }
    .about::before { background: radial-gradient(ellipse 90% 45% at 50% 30%, #2a2a2a 0%, var(--grey) 50%, var(--black) 100%); }
    .about::after { mask-image: radial-gradient(ellipse 80% 40% at 50% 30%, #000 0%, transparent 80%); }
    .about { grid-template-columns: minmax(0, 1fr); padding-top: 88px; padding-bottom: 88px; gap: 56px; }
  }

  @media (max-width: 479.98px) {
    .about { padding-top: 64px; padding-bottom: 64px; gap: 40px; }
    .title { font-size: 40px; }
    .copy { gap: 24px; }
    .copy p { font-size: 18px; }
    .facts { grid-template-columns: minmax(0, 1fr); gap: 20px; padding-top: 24px; }
  }
</style>

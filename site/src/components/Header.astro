---
interface Props {
  /** Adds the Gallery link; the section only renders when it has pieces. */
  gallery?: boolean;
}

const { gallery = false } = Astro.props;
const links = [
  { href: '#work', label: 'Work', ghost: '作品' },
  ...(gallery ? [{ href: '#gallery', label: 'Gallery', ghost: '画廊' }] : []),
  { href: '#designs', label: 'Designs', ghost: '図案' },
  { href: '#about', label: 'About', ghost: '紹介' },
];
---

<header class="site-header">
  <a class="brand" href="#top">
    <span class="brand-mark" aria-hidden="true">侍</span>
    <span class="brand-name">HALEBOY</span>
  </a>
  <nav class="nav" aria-label="Main">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-list">
      <svg class="icon-open" width="14" height="12" viewBox="0 0 14 12" aria-hidden="true"><path d="M0 1h14M0 6h14M0 11h14" stroke="currentColor" stroke-width="1.6" /></svg>
      <svg class="icon-close" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.6" /></svg>
      <span class="menu-label">Menu</span>
    </button>
    <ul class="nav-list" id="nav-list">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}<span class="ghost" aria-hidden="true">{l.ghost}</span></a></li>
      ))}
      <li>
        <a href="https://iloveyou.tattoo/" target="_blank" rel="noopener">The shop<span class="ghost ghost-domain">iloveyou.tattoo</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      </li>
    </ul>
    <a class="book" href="#book"><span class="book-long">Book a session</span><span class="book-short">Book</span></a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const list = document.getElementById('nav-list');
  const label = btn?.querySelector('.menu-label');
  if (btn && list && label) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    // Close on a link click or a click on the dimmed area outside the panel.
    list.addEventListener('click', (e) => {
      if (e.target === list || (e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 761px)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    height: 96px;
    /* Full-bleed bar; content stays aligned with the .page column. */
    padding: 0 max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--ink);
    background: var(--black);
    animation: header-drop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  /* Red line that sweeps across the bottom border. */
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--red);
    transform-origin: left;
    animation: line-sweep 1s 0.3s cubic-bezier(0.7, 0, 0.2, 1) both;
  }
  .brand-mark { animation: mark-pop 0.5s 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) both; }
  .brand:hover .brand-mark { animation: mark-wobble 0.4s ease; }
  .nav-list li, .book { animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .nav-list li:nth-child(1) { animation-delay: 0.4s; }
  .nav-list li:nth-child(2) { animation-delay: 0.48s; }
  .nav-list li:nth-child(3) { animation-delay: 0.56s; }
  .nav-list li:nth-child(4) { animation-delay: 0.64s; }
  .nav-list li:nth-child(5) { animation-delay: 0.72s; }
  .book { animation-delay: 0.8s; }

  @keyframes header-drop { from { transform: translateY(-100%); } }
  @keyframes line-sweep { from { transform: scaleX(0); } }
  @keyframes mark-pop { from { transform: scale(0) rotate(-90deg); } }
  @keyframes mark-wobble { 50% { transform: rotate(-12deg) scale(1.1); } }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .site-header::after, .brand-mark, .nav-list li, .book { animation: none !important; }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--bone);
    flex-shrink: 0;
  }
  .brand:hover { color: var(--bone); }
  .brand-mark {
    width: 40px;
    height: 40px;
    background: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--bone);
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.08em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.8vw, 40px);
    font-size: 17px;
    font-weight: 500;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: inherit;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-list a { text-decoration: none; color: var(--ash); }
  .nav-list a:hover { color: var(--bone); }
  .ghost { display: none; }

  .book {
    text-decoration: none;
    background: var(--red);
    color: var(--bone);
    padding: 13px 24px;
    font-weight: 700;
  }
  .book:hover { color: var(--bone); }
  .book-short, .menu-btn { display: none; }

  @media (max-width: 760px) {
    .site-header { height: 72px; }
    .nav { gap: 8px; }
    .book-long { display: none; }
    .book-short { display: inline; }
    .book { padding: 11px 16px; font-size: 16px; }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      height: 44px;
      padding: 0 16px;
      background: var(--black);
      border: 2px solid var(--bone);
      color: var(--bone);
      font: 500 14px var(--font-body);
      cursor: pointer;
    }
    .icon-close { display: none; }
    .menu-btn[aria-expanded='true'] .icon-open { display: none; }
    .menu-btn[aria-expanded='true'] .icon-close { display: block; }

    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 100vh;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgb(0 0 0 / 0.6);
    }
    .menu-btn[aria-expanded='true'] + .nav-list { display: flex; }
    /* Items re-animate each time the menu opens; keep the stagger snappy. */
    .nav-list li:nth-child(n) { animation-delay: calc(var(--i, 0) * 0.05s); }
    .nav-list li:nth-child(2) { --i: 1; }
    .nav-list li:nth-child(3) { --i: 2; }
    .nav-list li:nth-child(4) { --i: 3; }
    .nav-list li:nth-child(5) { --i: 4; }
    .nav-list li { background: var(--black); border-bottom: 1px solid var(--ink); }
    .nav-list li:last-child { border-bottom: 3px solid var(--red); }
    .nav-list a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 22px var(--gutter);
      font-family: var(--font-display);
      font-size: 28px;
      line-height: 1.1;
      color: var(--bone);
    }
    .nav-list a:focus-visible { outline-offset: -4px; }
    .ghost {
      display: inline;
      font-size: 22px;
      color: var(--ink);
    }
    .ghost-domain {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--ash);
    }
  }

  @media (max-width: 479.98px) {
    .site-header { gap: 8px; }
    .brand { gap: 10px; }
    .brand-name { font-size: 18px; letter-spacing: 0.05em; }
    .menu-btn { padding: 0 12px; gap: 8px; }
    .book { padding: 11px 14px; }
  }
  @media (max-width: 359.98px) {
    .brand-name { display: none; }
  }
</style>

---
// One shared viewer: any element with [data-zoom] that contains a <picture> opens it here, full size,
// over a blurred page. Optional data-alt, data-caption and data-href (shown as "View on Instagram").
---

<dialog class="lightbox" aria-label="Image viewer">
  <button class="close" type="button" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.6" /></svg>
  </button>
  <figure>
    <div class="stage" data-stage></div>
    <figcaption data-caption hidden></figcaption>
    <a class="ig" data-link href="#" target="_blank" rel="noopener" hidden>View on Instagram<span class="visually-hidden"> (opens in a new tab)</span></a>
  </figure>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const stage = dlg.querySelector<HTMLElement>('[data-stage]')!;
  const cap = dlg.querySelector<HTMLElement>('[data-caption]')!;
  const link = dlg.querySelector<HTMLAnchorElement>('[data-link]')!;

  document.addEventListener('click', (e) => {
    const t = (e.target as Element).closest<HTMLElement>('[data-zoom]');
    const pic = t?.querySelector('picture');
    if (!t || !pic) return;
    const clone = pic.cloneNode(true) as HTMLElement;
    // Ask for the large variant now that it fills the screen.
    clone.querySelectorAll('source, img').forEach((el) => el.setAttribute('sizes', '92vw'));
    const img = clone.querySelector('img')!;
    img.loading = 'eager';
    img.removeAttribute('class');
    if (t.dataset.alt) img.alt = t.dataset.alt;
    stage.replaceChildren(clone);
    cap.textContent = t.dataset.caption ?? '';
    cap.hidden = !cap.textContent;
    link.hidden = !t.dataset.href;
    if (t.dataset.href) link.href = t.dataset.href;
    dlg.showModal();
  });

  // Close on the ✕, or a click anywhere that isn't the image, caption or link.
  dlg.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('img, figcaption, a') || (e.target as Element).closest('.close')) dlg.close();
  });
  dlg.addEventListener('close', () => stage.replaceChildren());
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 16px 24px;
    border: 0;
    background: transparent;
    color: var(--bone);
    cursor: zoom-out;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.65);
    backdrop-filter: blur(14px);
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
  }
  .stage { display: flex; justify-content: center; min-height: 0; }
  .stage :global(img) {
    display: block;
    max-width: min(92vw, 1400px);
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
    cursor: default;
  }
  figcaption {
    max-width: 640px;
    text-align: center;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ash);
    cursor: auto;
  }
  .ig { font-size: 15px; font-weight: 500; color: var(--bone); }

  .close {
    position: fixed;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 2px solid var(--bone);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: var(--bone);
    cursor: pointer;
  }
  .close:hover { background: var(--red); border-color: var(--red); }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .stage { animation: pop 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
    .lightbox[open]::backdrop { animation: fade 0.28s ease; }
  }
  @keyframes pop { from { opacity: 0; transform: scale(0.94); } }
  @keyframes fade { from { opacity: 0; } }
</style>

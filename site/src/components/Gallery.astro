---
import type { GalleryItem } from '../lib/feed';
import Img from './Img.astro';

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const sizes = '(max-width: 479.98px) calc(100vw - 32px), (max-width: 899.98px) 50vw, 430px';
---

{items.length > 0 && (
  <section class="gallery" id="gallery" aria-labelledby="gallery-title">
    <div class="title-row">
      <h2 class="section-title" id="gallery-title">Gallery</h2>
      <span class="ghost" aria-hidden="true" data-glyph="画廊"></span>
    </div>
    <ul class="grid">
      {items.map((it) => {
        const caption = [it.title, it.placement].filter(Boolean).join(', ');
        return (
          <li class="panel cell">
            <Img class="photo" image={it.image} alt={caption ? `Tattoo: ${caption}` : 'Tattoo by Haleboy'} sizes={sizes} />
            {caption && <p class="caption" aria-hidden="true">{caption}</p>}
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .gallery {
    padding: 120px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .title-row { display: flex; align-items: flex-end; gap: 28px; }
  .ghost {
    font-family: var(--font-display);
    font-size: 80px;
    line-height: 1;
    color: var(--ink);
  }
  .ghost::before { content: attr(data-glyph); }

  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .cell {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .cell :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cell:hover :global(.photo) { transform: scale(1.04); }
  .caption {
    position: relative;
    margin: 0;
    padding: 72px 24px 20px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.9) 60%);
    color: var(--ash);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .cell :global(.photo) { transition: none; }
  }
  @media (max-width: 899.98px) {
    .gallery { padding-top: 88px; padding-bottom: 88px; gap: 40px; }
    .ghost { font-size: 56px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 479.98px) {
    .gallery { padding-top: 64px; padding-bottom: 64px; gap: 32px; }
    .title-row { gap: 16px; }
    .ghost { font-size: 40px; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .caption { padding: 72px 18px 16px; }
  }
</style>

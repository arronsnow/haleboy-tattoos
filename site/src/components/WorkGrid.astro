---
import { INSTAGRAM_URL, type WorkPanels } from '../lib/feed';
import Img from './Img.astro';

interface Props {
  work: WorkPanels;
}

const { work } = Astro.props;
const linked = work.source === 'instagram';
// The design's first six panels, then the rest of the latest 12 posts in rows of three; 斬 sits after the third.
const panels = work.panels.slice(0, 12);
const sizes = (i: number) =>
  i === 0
    ? '(max-width: 479.98px) calc(100vw - 32px), (max-width: 899.98px) calc(100vw - 80px), 640px'
    : '(max-width: 479.98px) calc(100vw - 32px), (max-width: 899.98px) 50vw, 640px';
---

<section class="work band" id="work" aria-labelledby="work-title">
  <div class="work-head">
    <div class="title-row">
      <h2 class="section-title" id="work-title">The work</h2>
      <span class="ghost" aria-hidden="true" data-glyph="作品"></span>
    </div>
    <a class="more" href={INSTAGRAM_URL} target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>@haleboy.tattoos<span class="more-cta">More on Instagram</span><span class="visually-hidden"> (opens in a new tab)</span></a>
  </div>

  <div class="grid">
    {panels.map((p, i) => {
      // Photos open in the shared Lightbox; Instagram posts get a link to the post there.
      const Tag = p.image ? 'button' : 'div';
      const zoom = p.image ? { type: 'button' as const, 'data-zoom': '', 'data-alt': p.alt, 'data-caption': p.caption, 'data-href': linked ? p.href : undefined } : {};
      return (
        <>
          <Tag class:list={['panel', 'cell', `cell-${i + 1}`, { 'has-image': p.image }]} {...zoom}>
            {p.image && <Img class="photo" image={p.image} alt={p.caption ? '' : p.alt} sizes={sizes(i)} />}
            {p.caption && <span class="caption">{p.caption}</span>}
            {p.image && <span class="visually-hidden"> (view larger)</span>}
          </Tag>
          {i === 2 && <div class="zan" aria-hidden="true">斬</div>}
        </>
      );
    })}
  </div>
</section>

<style>
  .work {
    padding: 120px var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
    --band: var(--grey);
  }
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 28px;
  }
  .title-row { display: flex; align-items: flex-end; gap: 28px; }
  .ghost {
    font-family: var(--font-display);
    font-size: 80px;
    line-height: 1;
    color: var(--ink);
  }
  /* Decorative ink-on-black by design; drawn as generated content so it isn't text for contrast checks. */
  .ghost::before { content: attr(data-glyph); }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 500;
    color: var(--bone);
  }
  .more svg { flex-shrink: 0; }
  .more-cta { margin-left: 6px; padding-left: 16px; border-left: 1px solid var(--field-border); color: var(--ash); }

  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 280px;
    gap: 16px;
  }
  .cell {
    position: relative;
    overflow: hidden;
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    text-decoration: none;
    color: var(--ash);
  }
  .cell-1 { grid-column: span 3; grid-row: span 2; }
  .cell-2 { grid-column: span 3; }
  button.cell {
    font: inherit;
    text-align: left;
    cursor: zoom-in;
  }
  button.cell :global(.photo) { transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  button.cell:hover :global(.photo) { transform: scale(1.03); }
  button.cell:hover .caption { color: var(--bone); }
  @media (prefers-reduced-motion: reduce) {
    button.cell :global(.photo) { transition: none; }
  }

  .cell :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .caption {
    position: relative;
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .cell-1 .caption { font-size: 18px; }
  /* Dark gradient behind captions that sit on a photo. */
  .has-image .caption {
    margin: -72px -24px -24px;
    padding: 72px 24px 24px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.9) 60%);
  }

  .zan {
    border: 3px solid var(--bone);
    background: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 72px;
    color: var(--black);
  }

  @media (max-width: 899.98px) {
    .work { padding-top: 88px; padding-bottom: 88px; gap: 40px; }
    .ghost { font-size: 56px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .cell, .cell-2, .zan { grid-column: span 1; aspect-ratio: 1; }
    .cell-1 { grid-column: span 2; grid-row: auto; }
  }

  @media (max-width: 479.98px) {
    .work { padding-top: 64px; padding-bottom: 64px; gap: 32px; }
    .title-row { gap: 16px; }
    .more-cta { display: none; }
    .ghost { font-size: 40px; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .cell-1 { grid-column: span 1; }
    .cell { padding: 18px; }
    .has-image .caption { margin: -72px -18px -18px; padding: 72px 18px 18px; }
    .zan { aspect-ratio: 3 / 1; font-size: 56px; }
  }
</style>

{
  "name": "haleboy-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy:ig-cron": "wrangler deploy --config workers/ig-cron/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply haleboy --local",
    "db:seed:local": "wrangler d1 execute haleboy --local --file=scripts/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply haleboy --remote",
    "db:seed:remote": "wrangler d1 execute haleboy --remote --file=scripts/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true
  }
}
